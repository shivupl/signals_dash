# Copy to .env and fill in. .env is gitignored.

# REQUIRED. SEC rejects requests without a declared User-Agent carrying a real
# contact address -- you get a 403 with no explanation. Format is
# "AppName/Version (contact@example.com)". Startup refuses to run if unset.
SEC_USER_AGENT=

# Postgres. Compose reads POSTGRES_PASSWORD; the app reads DATABASE_URL.
# Inside compose use the SERVICE NAME "postgres", not localhost.
POSTGRES_PASSWORD=dev
DATABASE_URL=postgresql://postgres:dev@postgres:5432/signals

REDIS_URL=redis://redis:6379/0

# Minimum score for an event to be pushed as a flag. Tune without redeploying:
# 7.01/8.01 filings score exactly 30 and will dominate volume at first.
FLAG_THRESHOLD=30

# Phase 1 is rules-only and never calls a model. The slot exists so the 8-K
# severity classifier can be dropped in later without touching config plumbing.
ANTHROPIC_API_KEY=

# Required to change settings (the flag threshold) from the dashboard. Leave
# blank and the settings panel is read-only. Pick something long; it is compared
# in constant time but it is still just a shared secret.
ADMIN_TOKEN=

# Production only (docker-compose.prod.yml): the hostname Caddy gets a
# certificate for. Its DNS A record must point at the server before first start.
SIGNALS_DOMAIN=
