# For running the app on the HOST (outside compose) against published ports.
# host.docker.internal is deliberately absent -- it works on macOS and silently
# does not on a Linux VPS.
SEC_USER_AGENT=
DATABASE_URL=postgresql://postgres:dev@localhost:5432/signals
REDIS_URL=redis://localhost:6379/0
FLAG_THRESHOLD=30
ANTHROPIC_API_KEY=
