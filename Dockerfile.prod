# Production image: the React UI is built in a throwaway node stage and copied
# into /app/web/dist, where the API serves it from /. Dev tooling is left out.

FROM node:20-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM python:3.12-slim

ENV TZ=UTC \
    PGTZ=UTC \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libxml2-dev libxslt1-dev \
 && rm -rf /var/lib/apt/lists/*

# Editable on purpose: config/, db/ and web/dist are found relative to src/.
COPY pyproject.toml ./
COPY src/ ./src/
RUN pip install --no-cache-dir -e .

COPY config/ ./config/
COPY db/ ./db/
COPY scripts/ ./scripts/
COPY --from=web /web/dist ./web/dist

RUN useradd --create-home --uid 1000 signals && chown -R signals:signals /app
USER signals

CMD ["python", "-m", "signals", "worker"]
